// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String            @id @default(cuid())
  name          String?
  firstName     String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  lastSeenAt    DateTime?
  accounts      Account[]
  sessions      Session[]
  wishlists     Wishlist[]
  wishlistItem  WishlistItem[]
  groups        Group[]           @relation(name: "OwnedGroups")
  subscribed    Group[]           @relation(name: "Subscribed")
  following     Wishlist[]        @relation(name: "FollowedWishlists")
  managing      Wishlist[]        @relation(name: "ManagedWishlists")
  drawnLots     DrawParticipant[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Group {
  id        String     @id @default(cuid())
  title     String
  createdAt DateTime
  theme     String?
  removed   Boolean    @default(false)
  wishlist  Wishlist[]
  createdBy User       @relation(name: "OwnedGroups", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  members   User[]     @relation(name: "Subscribed")
  draws     Draw[]
}

model Wishlist {
  id           String             @id @default(cuid())
  title        String?
  createdAt    DateTime
  theme        String?
  removed      Boolean            @default(false)
  wishlistItem WishlistItem[]
  categories   WishlistCategory[]
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups       Group[]
  shareToken   String?            @unique
  followers    User[]             @relation(name: "FollowedWishlists")
  managers     User[]             @relation(name: "ManagedWishlists")
}

model WishlistCategory {
  id           String         @id @default(cuid())
  title        String
  position     Int
  wishlistId   String
  wishlist     Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  wishlistItem WishlistItem[]

  @@unique([wishlistId, title])
}

model WishlistItem {
  id         String            @id @default(cuid())
  title      String
  unlimited  Boolean           @default(false)
  url        String?
  createdAt  DateTime
  removed    Boolean           @default(false)
  userId     String?
  boughtBy   User?             @relation(fields: [userId], references: [id])
  boughtAt   DateTime?
  wishlistId String
  wishlist   Wishlist          @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  categoryId String?
  category   WishlistCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  position   Int               @default(0)
}

model Reminder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  to        String
  from      String
}

model Draw {
  id           String            @id @default(cuid())
  createdAt    DateTime
  cancelledAt  DateTime?
  budget       Int?
  date         DateTime?
  groupId      String
  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  participants DrawParticipant[]
}

model DrawParticipant {
  id         String           @id @default(cuid())
  name       String
  email      String
  lastSentAt DateTime?
  drawId     String
  draw       Draw             @relation(fields: [drawId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  receiverId String?          @unique
  receiver   DrawParticipant? @relation("DrawnLot", fields: [receiverId], references: [id])
  giver      DrawParticipant? @relation("DrawnLot")

  @@unique([drawId, email])
}
